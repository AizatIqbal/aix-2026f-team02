# PostgreSQL / Supabase connection string.
# Example: postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/business_management

# MyMemory translation API uses no API key. Supplying a valid contact email
# raises its documented daily allowance;
MYMEMORY_EMAIL=
TRANSLATION_API_ENABLED=true

# Comma-separated frontend origins for local development / deployment.
CORS_ORIGINS=http://localhost:5173,http://localhost:8443
